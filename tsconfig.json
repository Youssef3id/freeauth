{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "core/**/*",
    "adapters/**/*",
    "services/**/*",
    "utils/**/*",
    "config/**/*",
    "middleware/**/*",
    "model/**/*"
  ]
}